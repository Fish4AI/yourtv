<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/settings_row_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/fish_accent_pressed" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/settings_row_focus" />
            <stroke
                android:width="1dp"
                android:color="@color/fish_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/settings_row_idle" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
